@page "/prints/new"
@page "/prints/edit/{Id:int}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Spoolbook.Desktop.Features.Profiles
@using Spoolbook.Desktop.Features.Settings.Printers
@using Spoolbook.Desktop.Features.Spools
@using Spoolbook.Desktop.Features.Prints
@using Spoolbook.Web.Services
@inject PrintService PrintService
@inject SpoolService SpoolService
@inject PrintProfileService ProfileService
@inject PrinterService PrinterService
@inject ProjectService ProjectService
@inject ProjectUploadService ProjectUploadService
@inject NavigationManager Nav

<PageTitle>@(Id is null ? "Log a print" : "Edit print")</PageTitle>

<h1 class="mb-6 text-2xl font-semibold text-slate-900">@(Id is null ? "Log a print" : "Edit print")</h1>

<div class="max-w-lg space-y-4">
    <div class="flex flex-col gap-1">
        <label class="text-sm font-medium text-slate-700">Project (optional)</label>
        <select @bind="selectedProjectId" @bind:after="OnProjectChangedAsync"
                class="rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500">
            <option value="0">-- none --</option>
            @foreach (var p in projects)
            {
                <option value="@p.Id">@p.FileName</option>
            }
        </select>
        <div class="mt-1 flex items-center gap-2">
            <InputFile OnChange="OnThreeMfSelectedAsync" class="text-sm text-slate-700" />
            @if (uploading)
            {
                <span class="text-xs text-slate-500">Uploading…</span>
            }
        </div>
        @if (uploadError is not null)
        {
            <p class="text-xs text-red-600">@uploadError</p>
        }
        @if (plates.Count > 0)
        {
            <label class="mt-2 text-sm font-medium text-slate-700">Plate</label>
            <select @bind="selectedPlaterId" class="rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500">
                @foreach (var plate in plates)
                {
                    <option value="@plate.PlaterId">@(plate.PlaterName ?? $"Plate {plate.PlaterId}")</option>
                }
            </select>
        }
    </div>

    <div class="flex flex-col gap-1">
        <label class="text-sm font-medium text-slate-700">Spool</label>
        <select @bind="selectedSpoolId" @bind:after="OnSpoolChangedAsync"
                class="rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500">
            <option value="0">-- pick a spool --</option>
            @foreach (var s in spools)
            {
                <option value="@s.Id">@s.Filament?.Brand @s.Filament?.Material @s.Filament?.Variant — @s.Filament?.Color @(s.LotCode is not null ? $"({s.LotCode})" : "")</option>
            }
        </select>
    </div>

    <div class="flex flex-col gap-1">
        <label class="text-sm font-medium text-slate-700">Profile</label>
        <select @bind="selectedProfileId" class="rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500">
            <option value="0">-- pick a profile --</option>
            @foreach (var p in profiles)
            {
                <option value="@p.Id">@p.Name</option>
            }
        </select>
    </div>

    <div class="flex flex-col gap-1">
        <label class="text-sm font-medium text-slate-700">Printer</label>
        <select @bind="selectedPrinterId" class="rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500">
            <option value="0">-- pick a printer --</option>
            @foreach (var pr in printers)
            {
                <option value="@pr.Id">@pr.Name</option>
            }
        </select>
    </div>

    <div class="flex flex-col gap-1">
        <label class="text-sm font-medium text-slate-700">Started</label>
        <input type="datetime-local" @bind="startedAt" class="rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" />
    </div>
    <div class="flex flex-col gap-1">
        <label class="text-sm font-medium text-slate-700">Ended</label>
        <input type="datetime-local" @bind="endedAt" class="rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" />
    </div>

    <div class="flex flex-col gap-1">
        <label class="text-sm font-medium text-slate-700">Result</label>
        <select @bind="status" class="rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500">
            @foreach (var s in Enum.GetValues<PrintStatus>())
            {
                <option value="@s">@s</option>
            }
        </select>
    </div>

    @if (status is PrintStatus.Failed or PrintStatus.Partial)
    {
        <div class="flex flex-col gap-1">
            <label class="text-sm font-medium text-slate-700">Failure modes</label>
            <div class="flex flex-wrap gap-2">
                @foreach (var mode in Enum.GetValues<FailureMode>())
                {
                    <label class="cursor-pointer select-none rounded-md border border-slate-300 px-3 py-1.5 text-sm text-slate-700 has-[:checked]:border-slate-900 has-[:checked]:bg-slate-900 has-[:checked]:text-white">
                        <input type="checkbox" class="sr-only" checked="@selectedFailureModes.Contains(mode)"
                               @onchange="@(e => ToggleFailureMode(mode, (bool)e.Value!))" />
                        @FailureModeLabel(mode)
                    </label>
                }
            </div>
        </div>
    }

    <div class="flex flex-col gap-1">
        <label class="text-sm font-medium text-slate-700">AMS humidity (%)</label>
        <input type="number" @bind="amsHumidityPct" class="rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" />
    </div>
    <div class="flex flex-col gap-1">
        <label class="text-sm font-medium text-slate-700">Actual room temp (°C)</label>
        <input type="number" step="0.1" @bind="actualRoomTempC" class="rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" />
    </div>
    <div>
        <label class="flex items-center gap-2 text-sm text-slate-700">
            <input type="checkbox" @bind="cleanBuildPlate" class="h-4 w-4 rounded border-slate-300" />
            Clean build plate
        </label>
    </div>

    <div class="flex flex-col gap-1">
        <label class="text-sm font-medium text-slate-700">Notes</label>
        <textarea @bind="notes" class="min-h-[80px] rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500"></textarea>
    </div>

    @if (errorMessage is not null)
    {
        <p class="text-sm text-red-600">@errorMessage</p>
    }

    <div class="flex items-center gap-3 pt-2">
        <button @onclick="SaveAsync" class="inline-flex items-center rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700">Save</button>
        <a href="/prints" class="text-sm text-slate-500 hover:text-slate-700">Cancel</a>
    </div>
</div>

@code {
    [Parameter]
    public int? Id { get; set; }

    private List<Spool> spools = [];
    private List<PrintProfile> profiles = [];
    private List<Printer> printers = [];
    private List<Project> projects = [];
    private List<ProjectPlate> plates = [];
    private int selectedSpoolId;
    private int selectedProfileId;
    private int selectedPrinterId;
    private int selectedProjectId;
    private string? selectedPlaterId;
    private bool uploading;
    private string? uploadError;
    private DateTime? startedAt;
    private DateTime? endedAt;
    private PrintStatus status = PrintStatus.Success;
    private HashSet<FailureMode> selectedFailureModes = [];
    private int? amsHumidityPct;
    private decimal? actualRoomTempC;
    private bool? cleanBuildPlate;
    private string? notes;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        spools = await SpoolService.ListAllAsync();
        printers = await PrinterService.ListAsync();
        projects = await ProjectService.ListAsync();

        if (Id is null) return;

        var existing = await PrintService.GetAsync(Id.Value);
        if (existing is null) return;

        selectedSpoolId = existing.SpoolId;
        selectedPrinterId = existing.PrinterId;
        startedAt = existing.StartedAt;
        endedAt = existing.EndedAt;
        status = existing.Status;
        selectedFailureModes = existing.FailureModes.Select(f => f.Mode).ToHashSet();
        amsHumidityPct = existing.AmsHumidityPct;
        actualRoomTempC = existing.ActualRoomTempC;
        cleanBuildPlate = existing.CleanBuildPlate;
        notes = existing.Notes;

        if (existing.Spool is not null)
        {
            profiles = await ProfileService.ListProfilesForFilamentAsync(existing.Spool.FilamentId);
            if (!profiles.Any(p => p.Id == existing.ProfileId) && existing.Profile is not null)
                profiles.Add(existing.Profile);
        }
        selectedProfileId = existing.ProfileId;

        if (existing.Project is not null)
        {
            selectedProjectId = existing.Project.Id;
            selectedPlaterId = existing.ProjectPlaterId;
            plates = ProjectService.ReadPlates(existing.Project.FilePath);
        }
    }

    private async Task OnSpoolChangedAsync()
    {
        selectedProfileId = 0;
        var spool = spools.FirstOrDefault(s => s.Id == selectedSpoolId);
        profiles = spool is null ? [] : await ProfileService.ListProfilesForFilamentAsync(spool.FilamentId);
    }

    private Task OnProjectChangedAsync()
    {
        var project = projects.FirstOrDefault(p => p.Id == selectedProjectId);
        plates = project is null ? [] : ProjectService.ReadPlates(project.FilePath);
        selectedPlaterId = plates.FirstOrDefault()?.PlaterId;
        return Task.CompletedTask;
    }

    private async Task OnThreeMfSelectedAsync(InputFileChangeEventArgs e)
    {
        uploading = true;
        uploadError = null;
        StateHasChanged();

        try
        {
            await using var stream = e.File.OpenReadStream(maxAllowedSize: 100 * 1024 * 1024);
            var result = await ProjectUploadService.SaveAndUpsertAsync(stream, e.File.Name);
            if (!result.Ok)
            {
                uploadError = $"Upload failed: {result.Error}";
                return;
            }

            var project = result.Project!;
            if (!projects.Any(p => p.Id == project.Id))
                projects.Add(project);

            selectedProjectId = project.Id;
            plates = ProjectService.ReadPlates(project.FilePath);
            selectedPlaterId = plates.FirstOrDefault()?.PlaterId;
        }
        finally
        {
            uploading = false;
        }
    }

    private void ToggleFailureMode(FailureMode mode, bool isChecked)
    {
        if (isChecked) selectedFailureModes.Add(mode);
        else selectedFailureModes.Remove(mode);
    }

    private static string FailureModeLabel(FailureMode mode) => mode switch
    {
        FailureMode.LayerAdhesion => "Layer Adhesion",
        FailureMode.UnderExtrusion => "Under-extrusion",
        FailureMode.OverExtrusion => "Over-extrusion",
        FailureMode.LayerShift => "Layer Shift",
        _ => mode.ToString()
    };

    private async Task SaveAsync()
    {
        if (selectedSpoolId == 0) { errorMessage = "Pick a spool."; return; }
        if (selectedProfileId == 0) { errorMessage = "Pick a profile."; return; }
        if (selectedPrinterId == 0) { errorMessage = "Pick a printer."; return; }
        if (startedAt is null || endedAt is null) { errorMessage = "Enter both start and end date/time."; return; }

        var input = new PrintInput
        {
            StartedAt = startedAt.Value,
            EndedAt = endedAt.Value,
            Status = status,
            Notes = string.IsNullOrWhiteSpace(notes) ? null : notes,
            AmsHumidityPct = amsHumidityPct,
            ActualRoomTempC = actualRoomTempC,
            CleanBuildPlate = cleanBuildPlate,
            FailureModes = selectedFailureModes.ToList(),
            ProjectId = selectedProjectId == 0 ? null : selectedProjectId,
            ProjectPlaterId = selectedProjectId == 0 ? null : selectedPlaterId
        };

        var result = Id.HasValue
            ? await PrintService.UpdateAsync(Id.Value, selectedPrinterId, input)
            : await PrintService.CreateAsync(selectedProfileId, selectedSpoolId, selectedPrinterId, input);

        if (!result.Ok)
        {
            errorMessage = result.Error;
            return;
        }

        Nav.NavigateTo("/prints");
    }
}
