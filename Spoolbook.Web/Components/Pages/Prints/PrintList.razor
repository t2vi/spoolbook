@page "/prints"
@using Microsoft.AspNetCore.Components.Authorization
@using Spoolbook.Desktop.Features.Prints
@inject PrintInventoryService InventoryService
@inject PrintService PrintService
@inject NavigationManager Nav

<PageTitle>Prints</PageTitle>

<h1 class="mb-6 text-2xl font-semibold text-slate-900">Prints</h1>

<div class="mb-4 flex flex-wrap items-center gap-3">
    <AuthorizeView>
        <Authorized><a href="/prints/new" class="inline-flex items-center rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700">+ Log a print</a></Authorized>
        <NotAuthorized><a href="@LoginUrl" class="text-sm text-slate-500 underline hover:text-slate-700">Sign in to edit</a></NotAuthorized>
    </AuthorizeView>
    <select @bind="statusFilter" @bind:after="ApplyFiltersAsync"
            class="rounded-md border border-slate-300 px-3 py-1.5 text-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500">
        <option value="">All statuses</option>
        @foreach (var s in Enum.GetValues<PrintStatus>())
        {
            <option value="@s">@s</option>
        }
    </select>
</div>

@if (result is null)
{
    <p class="text-slate-500">Loading…</p>
}
else
{
    <div class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
        <table class="w-full text-left text-sm">
            <thead class="bg-slate-50 text-xs font-medium uppercase text-slate-500">
                <tr><th class="px-4 py-3">Started</th><th class="px-4 py-3">Filament</th><th class="px-4 py-3">Profile</th><th class="px-4 py-3">Printer</th><th class="px-4 py-3">Status</th><th class="px-4 py-3"></th></tr>
            </thead>
            <tbody>
                @foreach (var p in result.Prints)
                {
                    <tr class="border-t border-slate-100 hover:bg-slate-50">
                        <td class="px-4 py-3 text-slate-700">@p.StartedAt.ToLocalTime().ToString("g")</td>
                        <td class="px-4 py-3 text-slate-700">@p.Spool?.Filament?.Brand @p.Spool?.Filament?.Material — @p.Spool?.Filament?.Color</td>
                        <td class="px-4 py-3 text-slate-700">@p.Profile?.Name</td>
                        <td class="px-4 py-3 text-slate-700">@p.Printer?.Name</td>
                        <td class="px-4 py-3">
                            <span class="@StatusBadgeClass(p.Status)">@p.Status</span>
                        </td>
                        <td class="px-4 py-3">
                            <AuthorizeView>
                                <Authorized>
                                    <a href="@($"/prints/edit/{p.Id}")" class="text-slate-600 hover:text-slate-900 hover:underline">Edit</a>
                                    <button @onclick="@(() => DeleteAsync(p.Id))" class="ml-3 text-red-600 hover:text-red-800 hover:underline">Delete</button>
                                </Authorized>
                            </AuthorizeView>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-4 flex items-center gap-3 text-sm text-slate-600">
        <span>Page @result.Page of @result.TotalPages (@result.Total total)</span>
        <button disabled="@(page <= 1)" @onclick="@(() => ChangePageAsync(page - 1))"
                class="rounded-md border border-slate-300 px-3 py-1.5 hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-40">Previous</button>
        <button disabled="@(page >= result.TotalPages)" @onclick="@(() => ChangePageAsync(page + 1))"
                class="rounded-md border border-slate-300 px-3 py-1.5 hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-40">Next</button>
    </div>
}

@if (errorMessage is not null)
{
    <p class="mt-3 text-sm text-red-600">@errorMessage</p>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private PrintInventoryResult? result;
    private string statusFilter = "";
    private int page = 1;
    private string? errorMessage;
    private string LoginUrl => $"/login?returnUrl={Uri.EscapeDataString(Nav.ToBaseRelativePath(Nav.Uri))}";

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        result = await InventoryService.ListAsync(new PrintInventoryQuery
        {
            Status = string.IsNullOrEmpty(statusFilter) ? null : Enum.Parse<PrintStatus>(statusFilter),
            Page = page,
            PageSize = 20
        });
    }

    private Task ApplyFiltersAsync()
    {
        page = 1;
        return LoadAsync();
    }

    private Task ChangePageAsync(int newPage)
    {
        page = newPage;
        return LoadAsync();
    }

    private async Task DeleteAsync(int id)
    {
        var authState = AuthStateTask is not null ? await AuthStateTask : null;
        if (authState?.User.Identity?.IsAuthenticated != true)
        {
            errorMessage = "Sign in to delete.";
            return;
        }

        var deleteResult = await PrintService.DeleteAsync(id);
        if (!deleteResult.Ok)
        {
            errorMessage = deleteResult.Error;
            return;
        }
        errorMessage = null;
        await LoadAsync();
    }

    private static string StatusBadgeClass(PrintStatus status)
    {
        const string baseClasses = "inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium";
        return status switch
        {
            PrintStatus.Success => $"{baseClasses} bg-green-100 text-green-800",
            PrintStatus.Partial => $"{baseClasses} bg-amber-100 text-amber-800",
            PrintStatus.Failed => $"{baseClasses} bg-red-100 text-red-800",
            _ => $"{baseClasses} bg-slate-100 text-slate-700"
        };
    }
}
