@page "/recommend"
@using Spoolbook.Desktop.Features.Prints
@using Spoolbook.Desktop.Features.Profiles
@inject ProjectService ProjectService
@inject PrintService PrintService

<PageTitle>Recommend a profile</PageTitle>

<h1>Recommend a profile</h1>

<p>Picks the best-matching profile from print history for a project, ranked by outcome then closest ambient temperature.</p>

@if (projects is null)
{
    <p>Loading…</p>
}
else
{
    <div>
        <label>Project</label>
        <select @bind="selectedProjectId">
            <option value="0">-- pick a project --</option>
            @foreach (var p in projects)
            {
                <option value="@p.Id">@p.FileName</option>
            }
        </select>
    </div>
    <div>
        <label>Current ambient temp (°C, optional)</label>
        <input type="number" step="0.1" @bind="currentTempC" />
    </div>

    <button @onclick="RecommendAsync">Recommend</button>

    @if (searched)
    {
        @if (recommended is null)
        {
            <p>No print history for this project yet.</p>
        }
        else
        {
            <h2>@recommended.Name</h2>
            <ul>
                <li>Nozzle: @recommended.NozzleTempC °C</li>
                @if (recommended.HotPlateTempC is not null)
                {
                    <li>Bed (hot plate): @recommended.HotPlateTempC °C</li>
                }
                @if (recommended.PrintSpeedMmS is not null)
                {
                    <li>Print speed: @recommended.PrintSpeedMmS mm/s</li>
                }
            </ul>
            <a href="@($"/profiles/edit/{recommended.Id}")">View full profile</a>
        }
    }
}

@code {
    private List<Project>? projects;
    private int selectedProjectId;
    private decimal? currentTempC;
    private PrintProfile? recommended;
    private bool searched;

    protected override async Task OnInitializedAsync()
    {
        projects = await ProjectService.ListAsync();
    }

    private async Task RecommendAsync()
    {
        searched = true;
        recommended = selectedProjectId == 0
            ? null
            : await PrintService.RecommendProfileForProjectAsync(selectedProjectId, currentTempC);
    }
}
