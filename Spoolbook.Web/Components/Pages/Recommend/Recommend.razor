@page "/recommend"
@using Spoolbook.Desktop.Features.Prints
@using Spoolbook.Desktop.Features.Profiles
@inject ProjectService ProjectService
@inject PrintService PrintService

<PageTitle>Recommend a profile</PageTitle>

<h1 class="mb-2 text-2xl font-semibold text-slate-900">Recommend a profile</h1>

<p class="mb-6 text-sm text-slate-600">Picks the best-matching profile from print history for a project, ranked by outcome then closest ambient temperature.</p>

@if (projects is null)
{
    <p class="text-slate-500">Loading…</p>
}
else
{
    <div class="max-w-lg space-y-4">
        <div class="flex flex-col gap-1">
            <label class="text-sm font-medium text-slate-700">Project</label>
            <select @bind="selectedProjectId" class="rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500">
                <option value="0">-- pick a project --</option>
                @foreach (var p in projects)
                {
                    <option value="@p.Id">@p.FileName</option>
                }
            </select>
        </div>
        <div class="flex flex-col gap-1">
            <label class="text-sm font-medium text-slate-700">Current ambient temp (°C, optional)</label>
            <input type="number" step="0.1" @bind="currentTempC" class="rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" />
        </div>

        <button @onclick="RecommendAsync" class="inline-flex items-center rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700">Recommend</button>
    </div>

    @if (searched)
    {
        @if (recommended is null)
        {
            <p class="mt-6 text-sm text-slate-500">No print history for this project yet.</p>
        }
        else
        {
            <div class="mt-6 max-w-lg rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
                <h2 class="mb-3 text-lg font-semibold text-slate-900">@recommended.Name</h2>
                <ul class="space-y-1 text-sm text-slate-600">
                    <li class="flex justify-between"><span>Nozzle</span><span class="font-medium text-slate-900">@recommended.NozzleTempC °C</span></li>
                    @if (recommended.HotPlateTempC is not null)
                    {
                        <li class="flex justify-between"><span>Bed (hot plate)</span><span class="font-medium text-slate-900">@recommended.HotPlateTempC °C</span></li>
                    }
                    @if (recommended.PrintSpeedMmS is not null)
                    {
                        <li class="flex justify-between"><span>Print speed</span><span class="font-medium text-slate-900">@recommended.PrintSpeedMmS mm/s</span></li>
                    }
                </ul>
                <a href="@($"/profiles/edit/{recommended.Id}")" class="mt-3 inline-block text-sm text-slate-600 hover:text-slate-900 hover:underline">View full profile</a>
            </div>
        }
    }
}

@code {
    private List<Project>? projects;
    private int selectedProjectId;
    private decimal? currentTempC;
    private PrintProfile? recommended;
    private bool searched;

    protected override async Task OnInitializedAsync()
    {
        projects = await ProjectService.ListAsync();
    }

    private async Task RecommendAsync()
    {
        searched = true;
        recommended = selectedProjectId == 0
            ? null
            : await PrintService.RecommendProfileForProjectAsync(selectedProjectId, currentTempC);
    }
}
