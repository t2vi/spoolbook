@page "/spools"
@using Microsoft.AspNetCore.Components.Authorization
@using Spoolbook.Desktop.Features.Spools
@inject SpoolService SpoolService
@inject NavigationManager Nav

<PageTitle>Spools</PageTitle>

<h1 class="mb-6 text-2xl font-semibold text-slate-900">Spools</h1>

<div class="mb-4">
    <AuthorizeView>
        <Authorized><a href="/spools/new" class="inline-flex items-center rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700">+ Add spool</a></Authorized>
        <NotAuthorized><a href="@LoginUrl" class="text-sm text-slate-500 underline hover:text-slate-700">Sign in to edit</a></NotAuthorized>
    </AuthorizeView>
</div>

@if (spools is null)
{
    <p class="text-slate-500">Loading…</p>
}
else
{
    <div class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
        <table class="w-full text-left text-sm">
            <thead class="bg-slate-50 text-xs font-medium uppercase text-slate-500">
                <tr>
                    <th class="px-4 py-3">Filament</th><th class="px-4 py-3">Lot code</th><th class="px-4 py-3">Purchased</th>
                    <th class="px-4 py-3">Opened</th><th class="px-4 py-3">Emptied</th><th class="px-4 py-3"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in spools)
                {
                    <tr class="border-t border-slate-100 hover:bg-slate-50">
                        <td class="px-4 py-3 text-slate-700">@s.Filament?.Brand @s.Filament?.Material @s.Filament?.Variant — @s.Filament?.Color</td>
                        <td class="px-4 py-3 text-slate-700">@s.LotCode</td>
                        <td class="px-4 py-3 text-slate-700">@s.PurchasedAt</td>
                        <td class="px-4 py-3 text-slate-700">@s.OpenedAt</td>
                        <td class="px-4 py-3 text-slate-700">@s.EmptiedAt</td>
                        <td class="px-4 py-3">
                            <AuthorizeView>
                                <Authorized>
                                    <a href="@($"/spools/edit/{s.Id}")" class="text-slate-600 hover:text-slate-900 hover:underline">Edit</a>
                                    <button @onclick="@(() => DeleteAsync(s.Id))" class="ml-3 text-red-600 hover:text-red-800 hover:underline">Delete</button>
                                </Authorized>
                            </AuthorizeView>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (errorMessage is not null)
{
    <p class="mt-3 text-sm text-red-600">@errorMessage</p>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private List<Spool>? spools;
    private string? errorMessage;
    private string LoginUrl => $"/login?returnUrl={Uri.EscapeDataString(Nav.ToBaseRelativePath(Nav.Uri))}";

    protected override async Task OnInitializedAsync() => spools = await SpoolService.ListAllAsync();

    private async Task DeleteAsync(int id)
    {
        var authState = AuthStateTask is not null ? await AuthStateTask : null;
        if (authState?.User.Identity?.IsAuthenticated != true)
        {
            errorMessage = "Sign in to delete.";
            return;
        }

        var result = await SpoolService.DeleteSpoolAsync(id);
        if (!result.Ok)
        {
            errorMessage = result.Error switch
            {
                "has_profiles" => "Can't delete — a Print Profile references this spool.",
                "has_prints" => "Can't delete — a Print references this spool.",
                _ => result.Error
            };
            return;
        }
        errorMessage = null;
        spools = await SpoolService.ListAllAsync();
    }
}
