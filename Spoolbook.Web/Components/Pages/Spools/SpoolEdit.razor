@page "/spools/new"
@page "/spools/edit/{Id:int}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Spoolbook.Desktop.Features.Settings.Filaments
@using Spoolbook.Desktop.Features.Spools
@inject SpoolService SpoolService
@inject FilamentService FilamentService
@inject NavigationManager Nav

<PageTitle>@(Id is null ? "Add spool" : "Edit spool")</PageTitle>

<h1 class="mb-6 text-2xl font-semibold text-slate-900">@(Id is null ? "Add spool" : "Edit spool")</h1>

<div class="max-w-lg space-y-4">
    @if (Id is null)
    {
        <div class="flex flex-col gap-1">
            <label class="text-sm font-medium text-slate-700">Filament</label>
            <select @bind="selectedFilamentId" class="rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500">
                <option value="0">-- pick a filament --</option>
                @foreach (var f in filaments)
                {
                    <option value="@f.Id">@f.Brand @f.Material @f.Variant — @f.Color</option>
                }
            </select>
        </div>
    }

    <EditForm Model="input" OnValidSubmit="SaveAsync" class="space-y-4">
        <div class="flex flex-col gap-1">
            <label class="text-sm font-medium text-slate-700">Lot code</label>
            <input @bind="input.LotCode" class="rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" />
        </div>
        <div class="flex flex-col gap-1">
            <label class="text-sm font-medium text-slate-700">Purchased</label>
            <input type="date" @bind="input.PurchasedAt" class="rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" />
        </div>
        <div class="flex flex-col gap-1">
            <label class="text-sm font-medium text-slate-700">Opened</label>
            <input type="date" @bind="input.OpenedAt" class="rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" />
        </div>
        <div class="flex flex-col gap-1">
            <label class="text-sm font-medium text-slate-700">Emptied</label>
            <input type="date" @bind="input.EmptiedAt" class="rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" />
        </div>
        <div class="flex flex-col gap-1">
            <label class="text-sm font-medium text-slate-700">Weight (g)</label>
            <input type="number" @bind="input.WeightGrams" class="rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" />
        </div>
        <div class="flex flex-col gap-1">
            <label class="text-sm font-medium text-slate-700">Diameter (mm)</label>
            <input type="number" step="0.01" @bind="input.DiameterMm" class="rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" />
        </div>
        <div class="flex flex-col gap-1">
            <label class="text-sm font-medium text-slate-700">Notes</label>
            <textarea @bind="input.Notes" class="min-h-[80px] rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500"></textarea>
        </div>

        @if (errorMessage is not null)
        {
            <p class="text-sm text-red-600">@errorMessage</p>
        }

        <div class="flex items-center gap-3 pt-2">
            <button type="submit" class="inline-flex items-center rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700">Save</button>
            <a href="/spools" class="text-sm text-slate-500 hover:text-slate-700">Cancel</a>
        </div>
    </EditForm>
</div>

@code {
    [Parameter]
    public int? Id { get; set; }

    private SpoolInput input = new();
    private List<Filament> filaments = [];
    private int selectedFilamentId;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        if (Id is null)
        {
            filaments = await FilamentService.ListAsync();
            return;
        }

        var existing = await SpoolService.GetSpoolAsync(Id.Value);
        if (existing is null) return;

        input = new SpoolInput
        {
            LotCode = existing.LotCode,
            PurchasedAt = existing.PurchasedAt,
            OpenedAt = existing.OpenedAt,
            EmptiedAt = existing.EmptiedAt,
            WeightGrams = existing.WeightGrams,
            DiameterMm = existing.DiameterMm,
            Notes = existing.Notes
        };
    }

    private async Task SaveAsync()
    {
        if (Id.HasValue)
        {
            var updateResult = await SpoolService.UpdateSpoolAsync(Id.Value, input);
            if (!updateResult.Ok) { errorMessage = updateResult.Error; return; }
            Nav.NavigateTo("/spools");
            return;
        }

        if (selectedFilamentId == 0)
        {
            errorMessage = "Pick a filament.";
            return;
        }

        var createResult = await SpoolService.CreateSpoolAsync(selectedFilamentId, input);
        if (!createResult.Ok) { errorMessage = createResult.Error; return; }
        Nav.NavigateTo("/spools");
    }
}
