@page "/"
@using Spoolbook.Desktop.Features.Dashboard
@inject DashboardMetricsService MetricsService

<PageTitle>Spoolbook</PageTitle>

<h1>Spoolbook</h1>

@if (metrics is null)
{
    <p>Loading…</p>
}
else
{
    <div style="display:flex; gap:24px; margin-bottom:24px;">
        <div>
            <div style="font-size:2em;">@metrics.FilamentCount</div>
            <div>Filaments</div>
        </div>
        <div>
            <div style="font-size:2em;">@metrics.SpoolsByStatus.Sum(c => c.Count)</div>
            <div>Spools</div>
        </div>
        <div>
            <div style="font-size:2em;">@metrics.PrintsByStatus.Sum(c => c.Count)</div>
            <div>Prints logged</div>
        </div>
    </div>

    @if (metrics.LastFilamentSyncAt is not null)
    {
        <p>Filament catalog last synced @metrics.LastFilamentSyncAt.Value.ToLocalTime().ToString("g")</p>
    }

    <div style="display:flex; gap:48px; flex-wrap:wrap;">
        <div>
            <h3>Spools by status</h3>
            <ul>
                @foreach (var c in metrics.SpoolsByStatus)
                {
                    <li>@c.Label: @c.Count</li>
                }
            </ul>
        </div>
        <div>
            <h3>Prints by outcome</h3>
            <ul>
                @foreach (var c in metrics.PrintsByStatus)
                {
                    <li>@c.Label: @c.Count</li>
                }
            </ul>
        </div>
        <div>
            <h3>Filaments by brand (top 10)</h3>
            <ul>
                @foreach (var c in metrics.FilamentsByBrand.Take(10))
                {
                    <li>@c.Label: @c.Count</li>
                }
            </ul>
        </div>
        <div>
            <h3>Filaments by material (top 10)</h3>
            <ul>
                @foreach (var c in metrics.FilamentsByMaterial.Take(10))
                {
                    <li>@c.Label: @c.Count</li>
                }
            </ul>
        </div>
    </div>
}

@code {
    private DashboardMetrics? metrics;

    protected override async Task OnInitializedAsync() => metrics = await MetricsService.GetMetricsAsync();
}
