@page "/profiles/new"
@page "/profiles/edit/{Id:int}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Spoolbook.Desktop.Features.BambuImport
@using Spoolbook.Desktop.Features.Profiles
@using Spoolbook.Desktop.Features.Settings.Filaments
@inject PrintProfileService ProfileService
@inject FilamentService FilamentService
@inject BambuFilamentImportService ImportService
@inject NavigationManager Nav

<PageTitle>@(Id is null ? "Add profile" : "Edit profile")</PageTitle>

<h1 class="mb-6 text-2xl font-semibold text-slate-900">@(Id is null ? "Add profile" : "Edit profile")</h1>

<div class="max-w-2xl space-y-4">
    @if (Id is null)
    {
        <div class="flex flex-col gap-1">
            <label class="text-sm font-medium text-slate-700">Filament</label>
            <select @bind="selectedFilamentId" class="rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500">
                <option value="0">-- pick a filament --</option>
                @foreach (var f in filaments)
                {
                    <option value="@f.Id">@f.Brand @f.Material @f.Variant — @f.Color</option>
                }
            </select>
        </div>

        <div class="flex flex-col gap-1">
            <label class="text-sm font-medium text-slate-700">Import from a sliced .3mf (optional)</label>
            <InputFile OnChange="OnThreeMfSelectedAsync" accept=".3mf"
                       class="text-sm text-slate-500 file:mr-3 file:cursor-pointer file:rounded-md file:border file:border-slate-300 file:bg-white file:px-3 file:py-1.5 file:text-sm file:font-medium file:text-slate-700 hover:file:bg-slate-50" />
            @if (importMessage is not null)
            {
                <p class="text-sm text-slate-600">@importMessage</p>
            }
        </div>
    }

    <div class="flex flex-col gap-1">
        <label class="text-sm font-medium text-slate-700">Name</label>
        <input @bind="name" class="rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" />
    </div>

    @* Most-commonly-tuned subset, not all ~140 PrintProfile fields — anything else the .3mf import
       matched still gets applied via the full Fields dict on save, just not shown for editing here. *@
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div class="flex flex-col gap-1">
            <label class="text-sm font-medium text-slate-700">Nozzle temp (°C)</label>
            <input @bind='Fields["NozzleTempC"]' class="rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" />
        </div>
        <div class="flex flex-col gap-1">
            <label class="text-sm font-medium text-slate-700">Nozzle temp, first layer (°C)</label>
            <input @bind='Fields["NozzleTempInitialC"]' class="rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" />
        </div>
        <div class="flex flex-col gap-1">
            <label class="text-sm font-medium text-slate-700">Hot plate temp (°C)</label>
            <input @bind='Fields["HotPlateTempC"]' class="rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" />
        </div>
        <div class="flex flex-col gap-1">
            <label class="text-sm font-medium text-slate-700">Hot plate temp, first layer (°C)</label>
            <input @bind='Fields["HotPlateTempInitialC"]' class="rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" />
        </div>
        <div class="flex flex-col gap-1">
            <label class="text-sm font-medium text-slate-700">Retraction (mm)</label>
            <input @bind='Fields["RetractionMm"]' class="rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" />
        </div>
        <div class="flex flex-col gap-1">
            <label class="text-sm font-medium text-slate-700">Retraction speed (mm/s)</label>
            <input @bind='Fields["RetractionSpeedMmS"]' class="rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" />
        </div>
        <div class="flex flex-col gap-1">
            <label class="text-sm font-medium text-slate-700">Fan min speed (%)</label>
            <input @bind='Fields["FanMinSpeedPct"]' class="rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" />
        </div>
        <div class="flex flex-col gap-1">
            <label class="text-sm font-medium text-slate-700">Fan max speed (%)</label>
            <input @bind='Fields["FanMaxSpeedPct"]' class="rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" />
        </div>
        <div class="flex flex-col gap-1">
            <label class="text-sm font-medium text-slate-700">Flow ratio</label>
            <input @bind='Fields["FlowRatio"]' class="rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" />
        </div>
    </div>

    @if (errorMessage is not null)
    {
        <p class="text-sm text-red-600">@errorMessage</p>
    }

    <div class="flex items-center gap-3 pt-2">
        <button @onclick="SaveAsync" class="inline-flex items-center rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700">Save</button>
        <a href="/profiles" class="text-sm text-slate-500 hover:text-slate-700">Cancel</a>
    </div>
</div>

@code {
    [Parameter]
    public int? Id { get; set; }

    private static readonly string[] EditableKeys =
    [
        "NozzleTempC", "NozzleTempInitialC", "HotPlateTempC", "HotPlateTempInitialC",
        "RetractionMm", "RetractionSpeedMmS", "FanMinSpeedPct", "FanMaxSpeedPct", "FlowRatio"
    ];

    private List<Filament> filaments = [];
    private int selectedFilamentId;
    private string name = "";
    private Dictionary<string, string> Fields = EditableKeys.ToDictionary(k => k, _ => "");
    private string? rawSettingsJson;
    private ProfileSource source = ProfileSource.Manual;
    private SlicerType? sourceSlicer;
    private string? importMessage;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        if (Id is null)
        {
            filaments = await FilamentService.ListAsync();
            return;
        }

        var existing = await ProfileService.GetProfileAsync(Id.Value);
        if (existing is null) return;

        name = existing.Name;
        var existingFields = ProfileFieldMapper.ToFieldStrings(existing);
        foreach (var key in EditableKeys)
            Fields[key] = existingFields.GetValueOrDefault(key, "");
    }

    private async Task OnThreeMfSelectedAsync(InputFileChangeEventArgs e)
    {
        var tempPath = Path.Combine(Path.GetTempPath(), $"spoolbook-upload-{Guid.NewGuid():N}.3mf");
        try
        {
            await using (var stream = File.Create(tempPath))
                await e.File.OpenReadStream(maxAllowedSize: 100 * 1024 * 1024).CopyToAsync(stream);

            var result = await ImportService.ImportFromThreeMfAsync(tempPath);
            if (!result.Ok)
            {
                importMessage = $"Import failed: {result.Error}";
                return;
            }

            foreach (var key in EditableKeys)
                if (result.Fields!.TryGetValue(key, out var value))
                    Fields[key] = value;

            // result.SuggestedName is derived from the server-side temp path (a GUID), not
            // useful here — use the browser upload's original filename instead.
            if (string.IsNullOrWhiteSpace(name))
                name = Path.GetFileNameWithoutExtension(e.File.Name);

            rawSettingsJson = result.RawSettingsJson;
            source = ProfileSource.SlicerImport;
            sourceSlicer = SlicerType.BambuStudio;
            importMessage = $"Imported {result.Fields!.Count} settings from {e.File.Name}.";
        }
        finally
        {
            if (File.Exists(tempPath)) File.Delete(tempPath);
        }
    }

    private async Task SaveAsync()
    {
        var input = new ProfileInput
        {
            Name = name,
            Fields = Fields,
            Source = source,
            SourceSlicer = sourceSlicer,
            RawSettingsJson = rawSettingsJson
        };

        var result = Id.HasValue
            ? await ProfileService.UpdateProfileAsync(Id.Value, input)
            : selectedFilamentId == 0
                ? new ProfileResult { Ok = false, Errors = new Dictionary<string, string> { ["Filament"] = "Pick a filament." } }
                : await ProfileService.CreateProfileAsync(selectedFilamentId, input);

        if (!result.Ok)
        {
            errorMessage = string.Join("; ", result.Errors?.Values ?? Enumerable.Empty<string>());
            return;
        }

        Nav.NavigateTo("/profiles");
    }
}
