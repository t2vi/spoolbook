@page "/filaments/new"
@page "/filaments/edit/{Id:int}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Spoolbook.Desktop.Features.Settings.Filaments
@inject FilamentService FilamentService
@inject NavigationManager Nav

<PageTitle>@(Id is null ? "Add filament" : "Edit filament")</PageTitle>

<h1>@(Id is null ? "Add filament" : "Edit filament")</h1>

<EditForm Model="input" OnValidSubmit="SaveAsync">
    <div>
        <label>Brand</label>
        <input @bind="input.Brand" />
    </div>
    <div>
        <label>Material</label>
        <input @bind="input.Material" />
    </div>
    <div>
        <label>Variant</label>
        <input @bind="input.Variant" />
    </div>
    <div>
        <label>Color</label>
        <input @bind="input.Color" />
    </div>

    @if (errorMessage is not null)
    {
        <p style="color:red">@errorMessage</p>
    }

    <button type="submit">Save</button>
    <a href="/filaments">Cancel</a>
</EditForm>

@code {
    [Parameter]
    public int? Id { get; set; }

    private FilamentInput input = new() { Brand = "", Material = "", Color = "" };
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        if (Id is null) return;

        var existing = (await FilamentService.ListAsync()).FirstOrDefault(f => f.Id == Id);
        if (existing is null) return;

        input = new FilamentInput { Brand = existing.Brand, Material = existing.Material, Variant = existing.Variant, Color = existing.Color };
    }

    private async Task SaveAsync()
    {
        var result = Id.HasValue
            ? await FilamentService.UpdateAsync(Id.Value, input)
            : await FilamentService.CreateAsync(input);

        if (!result.Ok)
        {
            errorMessage = result.Error == "duplicate" ? "This filament already exists." : result.Error;
            return;
        }

        Nav.NavigateTo("/filaments");
    }
}
