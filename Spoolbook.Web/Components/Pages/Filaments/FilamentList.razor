@page "/filaments"
@using Microsoft.AspNetCore.Components.Authorization
@using Spoolbook.Desktop.Features.Settings.Filaments
@using Spoolbook.Desktop.Features.Settings.General
@inject FilamentService FilamentService
@inject AppSettingsService AppSettingsService
@inject NavigationManager Nav

<PageTitle>Filaments</PageTitle>

<h1 class="mb-6 text-2xl font-semibold text-slate-900">Filaments</h1>

<div class="mb-4 flex flex-wrap items-center gap-3">
    <input @bind="brandFilter" @bind:event="oninput" @onkeyup="@(async e => await ApplyFiltersAsync())" placeholder="Filter by brand"
           class="rounded-md border border-slate-300 px-3 py-1.5 text-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" />
    <input @bind="materialFilter" @bind:event="oninput" @onkeyup="@(async e => await ApplyFiltersAsync())" placeholder="Filter by material"
           class="rounded-md border border-slate-300 px-3 py-1.5 text-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" />
    <AuthorizeView>
        <Authorized>
            <a href="/filaments/new" class="inline-flex items-center rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700">+ Add filament</a>
            <button @onclick="SyncCatalogAsync" disabled="@syncing"
                    class="inline-flex items-center rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 disabled:opacity-50">
                @(syncing ? "Syncing…" : "Sync filament catalog")
            </button>
        </Authorized>
        <NotAuthorized><a href="@LoginUrl" class="text-sm text-slate-500 underline hover:text-slate-700">Sign in to edit</a></NotAuthorized>
    </AuthorizeView>
</div>

@if (syncStatusMessage is not null)
{
    <p class="mb-3 text-sm text-slate-600">@syncStatusMessage</p>
}

@if (result is null)
{
    <p class="text-slate-500">Loading…</p>
}
else
{
    <div class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
        <table class="w-full text-left text-sm">
            <thead class="bg-slate-50 text-xs font-medium uppercase text-slate-500">
                <tr><th class="px-4 py-3">Brand</th><th class="px-4 py-3">Material</th><th class="px-4 py-3">Variant</th><th class="px-4 py-3">Color</th><th class="px-4 py-3"></th></tr>
            </thead>
            <tbody>
                @foreach (var f in result.Entries)
                {
                    <tr class="border-t border-slate-100 hover:bg-slate-50">
                        <td class="px-4 py-3 text-slate-700">@f.Brand</td>
                        <td class="px-4 py-3 text-slate-700">@f.Material</td>
                        <td class="px-4 py-3 text-slate-700">@f.Variant</td>
                        <td class="px-4 py-3 text-slate-700">@f.Color</td>
                        <td class="px-4 py-3">
                            <AuthorizeView>
                                <Authorized>
                                    <a href="@($"/filaments/edit/{f.Id}")" class="text-slate-600 hover:text-slate-900 hover:underline">Edit</a>
                                    <button @onclick="@(() => DeleteAsync(f.Id))" class="ml-3 text-red-600 hover:text-red-800 hover:underline">Delete</button>
                                </Authorized>
                            </AuthorizeView>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-4 flex items-center gap-3 text-sm text-slate-600">
        <span>Page @result.Page of @result.TotalPages (@result.Total total)</span>
        <button disabled="@(page <= 1)" @onclick="@(() => ChangePageAsync(page - 1))"
                class="rounded-md border border-slate-300 px-3 py-1.5 hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-40">Previous</button>
        <button disabled="@(page >= result.TotalPages)" @onclick="@(() => ChangePageAsync(page + 1))"
                class="rounded-md border border-slate-300 px-3 py-1.5 hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-40">Next</button>
    </div>
}

@if (errorMessage is not null)
{
    <p class="mt-3 text-sm text-red-600">@errorMessage</p>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private FilamentSearchResult? result;
    private string? brandFilter;
    private string? materialFilter;
    private int page = 1;
    private string? errorMessage;
    private bool syncing;
    private string? syncStatusMessage;
    private string LoginUrl => $"/login?returnUrl={Uri.EscapeDataString(Nav.ToBaseRelativePath(Nav.Uri))}";

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        result = await FilamentService.SearchAsync(new FilamentQuery
        {
            Brand = string.IsNullOrWhiteSpace(brandFilter) ? null : brandFilter,
            Material = string.IsNullOrWhiteSpace(materialFilter) ? null : materialFilter,
            Page = page,
            PageSize = 20
        });
    }

    private Task ApplyFiltersAsync()
    {
        page = 1;
        return LoadAsync();
    }

    private Task ChangePageAsync(int newPage)
    {
        page = newPage;
        return LoadAsync();
    }

    // AuthorizeView above only hides the button — this is the actual security boundary,
    // since a route's [Authorize] doesn't cover an in-page event handler like this one.
    private async Task DeleteAsync(int id)
    {
        var authState = AuthStateTask is not null ? await AuthStateTask : null;
        if (authState?.User.Identity?.IsAuthenticated != true)
        {
            errorMessage = "Sign in to delete.";
            return;
        }

        var deleteResult = await FilamentService.DeleteAsync(id);
        if (!deleteResult.Ok)
        {
            errorMessage = deleteResult.Error == "has_spools"
                ? "Can't delete — spools reference this filament."
                : deleteResult.Error;
            return;
        }
        errorMessage = null;
        await LoadAsync();
    }

    private async Task SyncCatalogAsync()
    {
        syncing = true;
        syncStatusMessage = "Syncing filament catalog…";
        StateHasChanged();

        var additionalSources = await AppSettingsService.GetAdditionalFilamentSourceUrlsAsync();
        var result = await new FilamentCatalogSyncService().FetchAsync(additionalSources);
        if (!result.Ok)
        {
            syncStatusMessage = $"Sync failed: {result.Error}";
            syncing = false;
            return;
        }

        var summary = await FilamentService.ImportManyAsync(result.Entries);
        await AppSettingsService.RecordFilamentSyncAsync();
        syncStatusMessage = $"Added {summary.Added} new, skipped {summary.Skipped} duplicates.";
        syncing = false;
        await LoadAsync();
    }
}
