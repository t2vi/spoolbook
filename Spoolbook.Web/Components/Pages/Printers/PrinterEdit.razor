@page "/printers/new"
@page "/printers/edit/{Id:int}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Spoolbook.Desktop.Features.Settings.Printers
@inject PrinterService PrinterService
@inject NavigationManager Nav

<PageTitle>@(Id is null ? "Add printer" : "Edit printer")</PageTitle>

<h1 class="mb-6 text-2xl font-semibold text-slate-900">@(Id is null ? "Add printer" : "Edit printer")</h1>

<EditForm Model="input" OnValidSubmit="SaveAsync" class="max-w-lg space-y-4">
    <div class="flex flex-col gap-1">
        <label class="text-sm font-medium text-slate-700">Name</label>
        <input @bind="input.Name" class="rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" />
    </div>
    <div class="flex flex-col gap-1">
        <label class="text-sm font-medium text-slate-700">Model</label>
        <input @bind="input.Model" class="rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" />
    </div>

    <h3 class="pt-2 text-sm font-semibold text-slate-900">Live telemetry (optional)</h3>
    <div class="flex flex-col gap-1">
        <label class="text-sm font-medium text-slate-700">IP address</label>
        <input @bind="input.IpAddress" class="rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" />
    </div>
    <div class="flex flex-col gap-1">
        <label class="text-sm font-medium text-slate-700">Access code</label>
        <input @bind="input.AccessCode" class="rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" />
    </div>
    <div class="flex flex-col gap-1">
        <label class="text-sm font-medium text-slate-700">Serial number</label>
        <input @bind="input.SerialNumber" class="rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" />
    </div>

    @if (errorMessage is not null)
    {
        <p class="text-sm text-red-600">@errorMessage</p>
    }

    <div class="flex items-center gap-3 pt-2">
        <button type="submit" class="inline-flex items-center rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700">Save</button>
        <a href="/printers" class="text-sm text-slate-500 hover:text-slate-700">Cancel</a>
    </div>
</EditForm>

@code {
    [Parameter]
    public int? Id { get; set; }

    private PrinterInput input = new() { Name = "" };
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        if (Id is null) return;

        var existing = (await PrinterService.ListAsync()).FirstOrDefault(p => p.Id == Id);
        if (existing is null) return;

        input = new PrinterInput
        {
            Name = existing.Name,
            Model = existing.Model,
            IpAddress = existing.IpAddress,
            AccessCode = existing.AccessCode,
            SerialNumber = existing.SerialNumber
        };
    }

    private async Task SaveAsync()
    {
        var result = Id.HasValue
            ? await PrinterService.UpdateAsync(Id.Value, input)
            : await PrinterService.CreateAsync(input);

        if (!result.Ok)
        {
            errorMessage = result.Error == "duplicate" ? "A printer with this name already exists." : result.Error;
            return;
        }

        Nav.NavigateTo("/printers");
    }
}
