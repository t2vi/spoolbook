@page "/printers"
@using Microsoft.AspNetCore.Components.Authorization
@using Spoolbook.Desktop.Features.Settings.Printers
@inject PrinterService PrinterService
@inject NavigationManager Nav

<PageTitle>Printers</PageTitle>

<h1 class="mb-6 text-2xl font-semibold text-slate-900">Printers</h1>

<div class="mb-4">
    <AuthorizeView>
        <Authorized><a href="/printers/new" class="inline-flex items-center rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700">+ Add printer</a></Authorized>
        <NotAuthorized><a href="@LoginUrl" class="text-sm text-slate-500 underline hover:text-slate-700">Sign in to edit</a></NotAuthorized>
    </AuthorizeView>
</div>

@if (printers is null)
{
    <p class="text-slate-500">Loading…</p>
}
else
{
    <div class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
        <table class="w-full text-left text-sm">
            <thead class="bg-slate-50 text-xs font-medium uppercase text-slate-500">
                <tr><th class="px-4 py-3">Name</th><th class="px-4 py-3">Model</th><th class="px-4 py-3">IP</th><th class="px-4 py-3"></th></tr>
            </thead>
            <tbody>
                @foreach (var p in printers)
                {
                    <tr class="border-t border-slate-100 hover:bg-slate-50">
                        <td class="px-4 py-3 text-slate-700">@p.Name</td>
                        <td class="px-4 py-3 text-slate-700">@p.Model</td>
                        <td class="px-4 py-3 text-slate-700">@p.IpAddress</td>
                        <td class="px-4 py-3">
                            <a href="@($"/printers/{p.Id}/status")" class="text-slate-600 hover:text-slate-900 hover:underline">Status</a>
                            <AuthorizeView>
                                <Authorized>
                                    <a href="@($"/printers/edit/{p.Id}")" class="ml-3 text-slate-600 hover:text-slate-900 hover:underline">Edit</a>
                                    <button @onclick="@(() => DeleteAsync(p.Id))" class="ml-3 text-red-600 hover:text-red-800 hover:underline">Delete</button>
                                </Authorized>
                            </AuthorizeView>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (errorMessage is not null)
{
    <p class="mt-3 text-sm text-red-600">@errorMessage</p>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private List<Printer>? printers;
    private string? errorMessage;
    private string LoginUrl => $"/login?returnUrl={Uri.EscapeDataString(Nav.ToBaseRelativePath(Nav.Uri))}";

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync() => printers = await PrinterService.ListAsync();

    private async Task DeleteAsync(int id)
    {
        var authState = AuthStateTask is not null ? await AuthStateTask : null;
        if (authState?.User.Identity?.IsAuthenticated != true)
        {
            errorMessage = "Sign in to delete.";
            return;
        }

        var deleteResult = await PrinterService.DeleteAsync(id);
        if (!deleteResult.Ok)
        {
            errorMessage = deleteResult.Error == "has_prints"
                ? "Can't delete — prints reference this printer."
                : deleteResult.Error;
            return;
        }
        errorMessage = null;
        await LoadAsync();
    }
}
