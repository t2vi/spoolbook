<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        mc:Ignorable="d"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        x:Class="Spoolbook.Desktop.Common.UnsavedChangesWindow"
        Width="360" SizeToContent="Height"
        Background="#26292C"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <StackPanel Margin="16" Spacing="16">
        <TextBlock Text="Unsaved changes" FontWeight="Bold"/>
        <TextBlock Text="You have unsaved changes. What would you like to do?" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Keep editing" Click="OnKeepEditingClick"/>
            <Button Content="Discard" Click="OnDiscardClick"/>
            <Button Content="Save" Click="OnSaveClick"/>
        </StackPanel>
    </StackPanel>
</Window>
