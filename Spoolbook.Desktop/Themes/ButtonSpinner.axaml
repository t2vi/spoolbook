<ResourceDictionary xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Overrides Fluent's default ButtonSpinner (used internally by NumericUpDown) to render a
         compact, vertically-stacked up/down pair on the left, matching Bambu Studio's own spinner
         style. RepeatButton (not the base Button the TemplatePartAttribute declares) so press-and-hold
         still auto-repeats. -->
    <ControlTheme x:Key="{x:Type ButtonSpinner}" TargetType="ButtonSpinner">
        <Setter Property="Background" Value="{DynamicResource TextControlBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TextControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource TextControlBorderThemeThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        <Setter Property="MinHeight" Value="{DynamicResource TextControlThemeMinHeight}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="ButtonSpinner">
                <!-- Fluent's own ButtonSpinner draws its idle/focused/hover border on this outer
                     Border — our replacement template above had dropped it entirely, so
                     NumericUpDown's BorderBrush/BorderThickness TemplateBindings (set on
                     PART_Spinner, see NumericUpDown's own template) had nothing to render onto. -->
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        MinHeight="{TemplateBinding MinHeight}">
                    <Grid ColumnDefinitions="Auto,*">
                        <Grid Grid.Column="0" RowDefinitions="*,*" IsVisible="{TemplateBinding ShowButtonSpinner}"
                              Margin="2,0,2,0">
                            <RepeatButton Grid.Row="0" Name="PART_IncreaseButton"
                                          IsEnabled="{TemplateBinding AllowSpin}"
                                          Content="▲" FontSize="7" Padding="0"
                                          MinWidth="14" Height="10"
                                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                            <RepeatButton Grid.Row="1" Name="PART_DecreaseButton"
                                          IsEnabled="{TemplateBinding AllowSpin}"
                                          Content="▼" FontSize="7" Padding="0"
                                          MinWidth="14" Height="10"
                                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        </Grid>
                        <ContentPresenter Grid.Column="1" Name="PART_ContentPresenter"
                                           Content="{TemplateBinding Content}"
                                           Padding="{TemplateBinding Padding}"
                                           HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                           VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
