<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Button.tableHeader">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0,4"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style Selector="NumericUpDown">
        <Setter Property="ButtonSpinnerLocation" Value="Left"/>
    </Style>

    <!-- DataGridCell's Fluent template draws the selected/focused-cell outline via
         Rectangle strokes bound to DataGridCellFocusVisualPrimaryBrush/SecondaryBrush (see
         PART_CellRoot's "FocusVisual" grid, shown on the ^:focus pseudo-class) — shadow both
         to transparent so selecting a cell doesn't draw the ring. -->
    <Style Selector="DataGridCell">
        <Style.Resources>
            <SolidColorBrush x:Key="DataGridCellFocusVisualPrimaryBrush" Color="Transparent" />
            <SolidColorBrush x:Key="DataGridCellFocusVisualSecondaryBrush" Color="Transparent" />
        </Style.Resources>
    </Style>
</Styles>
